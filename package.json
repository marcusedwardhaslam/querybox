{
  "name": "querybox",
  "version": "1.0.0",
  "description": "A free and open source SQL gui made in Electron",
  "main": "dist/main.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start": "npm run build:dev && electron .",
    "dev": "webpack --mode development --watch",
    "package": "electron-builder",
    "test": "echo \"No tests specified\""
  },
  "keywords": ["sql", "database", "electron", "gui"],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.querybox.app",
    "productName": "QueryBox",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.4",
    "sass": "^1.94.0",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
